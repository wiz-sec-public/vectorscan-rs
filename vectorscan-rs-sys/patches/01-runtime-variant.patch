+enum fat_variant {
+    FAT_VARIANT_AVX512VBMI,
+    FAT_VARIANT_AVX512,
+    FAT_VARIANT_AVX2,
+    FAT_VARIANT_COREI7,
+    FAT_VARIANT_SIMDE,
+};
+
+/* Single source of truth for variant selection, shared by every resolver and
+ * by hs_runtime_variant(). */
+static enum fat_variant fat_select_variant(void) {
+    if (check_avx512vbmi()) {
+        return FAT_VARIANT_AVX512VBMI;
+    }
+    if (check_avx512()) {
+        return FAT_VARIANT_AVX512;
+    }
+    if (check_avx2()) {
+        return FAT_VARIANT_AVX2;
+    }
+    if (check_sse42() && check_popcnt()) {
+        return FAT_VARIANT_COREI7;
+    }
+    /* If no SSE4.2 is available we fallback to SIMDe */
+    return FAT_VARIANT_SIMDE;
+}
+
+static const char *fat_variant_name(enum fat_variant v) {
+    switch (v) {
+    case FAT_VARIANT_AVX512VBMI:
+        return "avx512vbmi";
+    case FAT_VARIANT_AVX512:
+        return "avx512";
+    case FAT_VARIANT_AVX2:
+        return "avx2";
+    case FAT_VARIANT_COREI7:
+        return "corei7";
+    case FAT_VARIANT_SIMDE:
+#if defined(VS_SIMDE_BACKEND)
+        return "simde";
+#else
+        return "none";
+#endif
+    }
+    return "none";
+}
