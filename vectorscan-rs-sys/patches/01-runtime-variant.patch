 hs_error_t HS_CDECL hs_valid_platform(void);
 
+/**
+ * Utility function to report the SIMD implementation that runtime calls (such
+ * as @ref hs_scan()) dispatch to on the current system.
+ *
+ * In fat runtime builds this runs the same CPU feature checks as the runtime
+ * dispatcher, so it may be called before any database is compiled or scanned.
+ * Possible values are "avx512vbmi", "avx512", "avx2", "corei7" and "simde" on
+ * x86, "sve2", "sve" and "neon" on AArch64, and "vsx" on POWER. Fat runtime
+ * builds report "none" if no supported implementation is available.
+ * Single-implementation builds report the implementation they were compiled
+ * for, or "generic" on any other architecture.
+ *
+ * @return
+ *      A statically allocated string, which does not need to be freed.
+ */
+const char * HS_CDECL hs_runtime_variant(void);
+
 /**
  * @defgroup HS_ERROR hs_error_t values
  *
diff --git i/src/hs_valid_platform.c w/src/hs_valid_platform.c
index 0d7b5afd..da9c08d1 100644
--- i/src/hs_valid_platform.c
+++ w/src/hs_valid_platform.c
@@ -66,3 +66,31 @@ hs_error_t HS_CDECL hs_valid_platform(void) {
 #endif
     return HS_SUCCESS;
 }
+
+#if !defined(FAT_RUNTIME)
+/* Fat runtime builds define this in dispatcher.c. */
+HS_PUBLIC_API
+const char * HS_CDECL hs_runtime_variant(void) {
+#if defined(VS_SIMDE_BACKEND)
+    return "simde";
+#elif defined(HAVE_AVX512VBMI)
+    return "avx512vbmi";
+#elif defined(HAVE_AVX512)
+    return "avx512";
+#elif defined(HAVE_AVX2)
+    return "avx2";
+#elif defined(ARCH_IA32) || defined(ARCH_X86_64)
+    return "corei7";
+#elif defined(HAVE_SVE2)
+    return "sve2";
+#elif defined(HAVE_SVE)
+    return "sve";
+#elif defined(ARCH_ARM32) || defined(ARCH_AARCH64)
+    return "neon";
+#elif defined(ARCH_PPC64EL)
+    return "vsx";
+#else
+    return "generic";
+#endif
+}
+#endif
